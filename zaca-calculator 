
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zaca Calculator</title>
    
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: #1e1e24;
        }

        .calculator {
            width: 320px;
            background-color: #2b2d42;
            padding: 20px;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
        }

        .brand {
            color: #ef233c;
            font-size: 0.8rem;
            font-weight: bold;
            text-align: right;
            margin-bottom: 5px;
            letter-spacing: 1px;
        }

        #screen-container {
            width: 100%;
            height: 70px;
            background-color: #8d99ae;
            border-radius: 10px;
            padding: 10px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            overflow-x: auto;
            white-space: nowrap;
        }

        #screen {
            font-size: 2rem;
            color: #2b2d42;
            text-align: right;
            transition: font-size 0.1s ease;
        }

        .buttons {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .btn {
            height: 50px;
            border: none;
            border-radius: 10px;
            font-size: 1.2rem;
            font-weight: bold;
            cursor: pointer;
            background-color: #edf2f4;
            color: #2b2d42;
            transition: background 0.2s;
        }

        .btn:active {
            transform: scale(0.95);
        }

        .operator {
            background-color: #d90429;
            color: white;
        }

        .clear {
            background-color: #ef233c;
            color: white;
        }

        .delete {
            background-color: #f77f00;
            color: white;
        }

        .equal {
            grid-row: span 2;
            height: 110px;
            background-color: #4caf50;
            color: white;
        }

        .zero {
            grid-column: span 2;
        }
    </style>
</head>
<body>

    <div class="calculator">
        <div class="brand">ZACA CALCULATOR</div>
        <div id="screen-container">
            <div id="screen">0</div>
        </div>
        
        <div class="buttons">
            <button class="btn clear" onclick="clearScreen()">C</button>
            <button class="btn delete" onclick="deleteLast()">DEL</button>
            <button class="btn operator" onclick="appendValue('/')">÷</button>
            <button class="btn operator" onclick="appendValue('*')">×</button>

            <button class="btn" onclick="appendValue('7')">7</button>
            <button class="btn" onclick="appendValue('8')">8</button>
            <button class="btn" onclick="appendValue('9')">9</button>
            <button class="btn operator" onclick="appendValue('-')">-</button>

            <button class="btn" onclick="appendValue('4')">4</button>
            <button class="btn" onclick="appendValue('5')">5</button>
            <button class="btn" onclick="appendValue('6')">6</button>
            <button class="btn operator" onclick="appendValue('+')">+</button>

            <button class="btn" onclick="appendValue('1')">1</button>
            <button class="btn" onclick="appendValue('2')">2</button>
            <button class="btn" onclick="appendValue('3')">3</button>
            <button class="btn equal" onclick="calculate()">=</button>

            <button class="btn zero" onclick="appendValue('0')">0</button>
            <button class="btn" onclick="appendValue('.')">.</button>
        </div>
    </div>

    
    <script>
        const screen = document.getElementById('screen');
        const container = document.getElementById('screen-container');

        function adjustFontSize() {
            let len = screen.innerText.length;
            if (len > 12) {
                screen.style.fontSize = "1.1rem"; 
            } else if (len > 8) {
                screen.style.fontSize = "1.5rem"; 
            } else {
                screen.style.fontSize = "2rem";   
            }
            container.scrollLeft = container.scrollWidth;
        }

        function appendValue(value) {
            if (screen.innerText === '0' && !isNaN(value)) {
                screen.innerText = value;
            } else if (screen.innerText === 'Error') {
                screen.innerText = value;
            } else {
                screen.innerText += value;
            }
            adjustFontSize();
        }

        document.querySelectorAll('.btn').forEach(button => {
            button.addEventListener('click', function() {
                this.blur(); 
            });
        });

        function clearScreen() {
            screen.innerText = '0';
            adjustFontSize();
        }

        function deleteLast() {
            if (screen.innerText.length > 1) {
                screen.innerText = screen.innerText.slice(0, -1);
            } else {
                screen.innerText = '0';
            }
            adjustFontSize();
        }

        function calculate() {
            try {
                if (screen.innerText) {
                    let result = new Function('return ' + screen.innerText)();
                    if (result % 1 !== 0) {
                        result = parseFloat(result.toFixed(4));
                    }
                    screen.innerText = result;
                }
            } catch (error) {
                screen.innerText = 'Error';
            }
            adjustFontSize();
        }
    </script>

</body>
</html>
